 for j from 1 to 2 do\n            diagonal := 0;\n            if i = \+
j then\n                diagonal := 1;\n            end if;\n         \+
   rowBound := rowBound\n                + abs(diagonal - Y[i][1]*midp
oint(JX[1][j])\n                               - Y[i][2]*midpoint(JX[2
][j]))\n                + abs(Y[i][1])*radius(JX[1][j])\n             \+
   + abs(Y[i][2])*radius(JX[2][j]);\n        end do;\n        imageBou
nd := eps*rowBound\n            + abs(Y[i][1]*midpoint(f0[1])+Y[i][2]*
