   lower, upper := 0, 0;\n        for k from 0 to 12 do\n            e
 := k*(k-1)/2;\n            if k >= iw and e >= iq then\n             \+
   coefficient := (-1)^k*binomial(k, iw)*factorial(iw)\n              \+
                       *binomial(e, iq)*factorial(iq);\n              \+
  term1 := coefficient*wRange[1]^(k-iw)*qRange[1]^(e-iq);\n           \+
     term2 := coefficient*wRange[2]^(k-iw)*qRange[2]^(e-iq);\n        \+
        lower := lower + min(term1, term2);\n                upper := \+
upper + max(term1, term2);\n            end if;\n        end do;\n\n  \+
      # For 1/4 < q < 1/3 and 1 < w < 3, bound each omitted\n        #
 term by k^iw*e^iq*4^iq*3^(k-e).\n        firstOmitted := 13;\n       \+
 firstExponent := firstOmitted*(firstOmitted-1)/2;\n        if 2^(iw+2
*iq+1) >= 3^(firstOmitted-1) then\n            error \"the geometric t
ail ratio is not below 1/2\";\n        end if;\n        tail := 2*firs
tOmitted^iw*firstExponent^iq*4^iq\n                 / 3^(firstExponent
-firstOmitted);\n        return [lower-tail, upper+tail];\n    end pro
c;\n\n    midpoint := B -> (B[1]+B[2])/2;\n    radius := B -> (B[2]-B[
1])/2;\n\n    q0 := 3092493386004/10^13;\n    w0 := 2320376944290/10^1
2;\n    eps := 1/10^12;\n    Q := [q0-eps, q0+eps];\n    W := [w0-eps,
 w0+eps];\n    if Q[1] <= 309/1000 or Q[2] >= 1237/4000 or\n       W[1
] <= 2 or W[2] >= 233/100 then\n        error \"the box lies outside t
he stated bounds\";\n    end if;\n\n    Q0, W0 := [q0, q0], [w0, w0];
\n    f0 := [DerivativeInterval(Q0, W0, 0, 0),\n           DerivativeI
nterval(Q0, W0, 1, 0)];\n    J0 := [[DerivativeInterval(Q0, W0, 0, 1),
 f0[2]],\n           [DerivativeInterval(Q0, W0, 1, 1),\n            D
erivativeInterval(Q0, W0, 2, 0)]];\n    JX := [[DerivativeInterval(Q, \+
W, 0, 1), DerivativeInterval(Q, W, 1, 0)],\n           [DerivativeInte
rval(Q, W, 1, 1), DerivativeInterval(Q, W, 2, 0)]];\n\n    a, b := mid
point(J0[1][1]), midpoint(J0[1][2]);\n    c, d := midpoint(J0[2][1]), \+
midpoint(J0[2][2]);\n    determinant := a*d-b*c;\n    if determinant =
 0 then\n        error \"the midpoint matrix is singular\";\n    end i
f;\n    Y := [[d/determinant, -b/determinant],\n          [-c/determin
ant, a/determinant]];\n\n    rowLimit := [234/10^13, 301/10^12];\n    \+
imageLimit := [323/10^15, 397/10^15];\n    printf(\"Coordinate order (
