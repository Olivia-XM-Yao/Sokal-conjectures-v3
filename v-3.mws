       end if;\n        printf(\"Row %d sum <= 0.%018d   PASS\\n\", i,
 rowUpper);\n        printf(\"Coordinate %d image distance <= 0.%018d \+
  PASS\\n\",\n               i, imageUpper);\n    end do;\n\n    print
f(\"Box inclusion and contraction verified.\\n\");\n    printf(\"|rho \+
